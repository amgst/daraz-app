# Shopify Partner app credentials (from partners.shopify.com -> your app -> Client credentials).
# `shopify app config link` / `shopify app dev` write these into .env automatically once you
# run them interactively - you usually won't set SHOPIFY_API_KEY/SECRET by hand.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_inventory,write_inventory
SHOPIFY_APP_URL=

# Supabase Postgres. Use the pooled (pgbouncer, port 6543) connection for DATABASE_URL
# and the direct (port 5432) connection for DIRECT_URL (Prisma migrations need a direct
# connection). Found in Supabase project -> Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Daraz Open Platform app (App Console -> App Overview -> Advanced Information).
DARAZ_APP_KEY=505676
DARAZ_APP_SECRET=
# Must exactly match the Callback URL set in the Daraz App Console.
DARAZ_REDIRECT_URI=https://your-app-domain.com/daraz/callback

# 32-byte key, base64-encoded, used to encrypt Daraz tokens at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` - set the same
# value in your Vercel project's env vars. Generate with: openssl rand -hex 32
CRON_SECRET=
